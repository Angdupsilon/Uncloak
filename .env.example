# ---- Tiger Cloud (PostgreSQL + TimescaleDB) ------------------------------
# Owner role: used by the ETL scripts and for running db/*.sql.   <<FILL>>
DATABASE_URL=
# Read-only role gridsight_ro (db/003_readonly_role.sql): used by the web app.   <<FILL>>
DATABASE_URL_RO=

# ---- Gemini (Ask GridSight) ----------------------------------------------
GEMINI_API_KEY=        # <<FILL>>
GEMINI_MODEL=          # <<FILL>>

# ---- Scoring ---------------------------------------------------------------
# Construction cost (USD) per MW of IT load. mw_est = registered cost / this.   <<FILL>>
# Leave blank and GridSight shows no MW/GW figures rather than guessing.
MW_COST_PER_MW_USD=
# First Monday of the weekly score backfill (optional; default 2024-01-01).
BACKFILL_START=2024-01-01

# ---- Spare capacity (etl/pull_power_plants.py) -----------------------------
# Free api.data.gov key for the EPA CAMPD API. Blank falls back to DEMO_KEY (rate-limited).
EPA_API_KEY=
