{"nodes": [{"id": "readme_gridsight", "label": "GridSight", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_shadow_load", "label": "Shadow Load", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_time_machine", "label": "Time Machine", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ask_gridsight", "label": "Ask GridSight", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_data_honesty", "label": "Data Honesty Principle", "file_type": "rationale", "rationale": "Every number in the UI must come from the database. SAMPLE fixtures are deliberately and visibly fake (names prefixed SAMPLE, source_url = SAMPLE, yellow banner) so the app can run before real data exists without the demo ever being mistaken for verified findings. Unverified real rows are marked <<FILL>> and skipped at load with a warning rather than guessed.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}, {"id": "readme_evidence_index", "label": "Evidence Index (uncalibrated)", "file_type": "rationale", "rationale": "Scoring is a weighted points sum divided by 100, deliberately labelled 'Evidence index (uncalibrated)' and never called a probability, because the weights are hand-chosen and not fit to outcomes. Tiers: verified >= 0.7, likely >= 0.4, else low.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}, {"id": "readme_scoring_config", "label": "scoring_config table", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_as_of_query", "label": "As-of Query Pattern", "file_type": "rationale", "rationale": "A score dated D uses only evidence dated on or before D (whole day, UTC), implemented as ORDER BY ts DESC LIMIT 1 over the (project_id, ts DESC) index. This makes the whole dashboard rewindable without recomputation and prevents future evidence leaking into past scores.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}, {"id": "readme_hypertables", "label": "TimescaleDB Hypertables", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_weekly_project_state", "label": "weekly_project_state continuous aggregate", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_weekly_realistic_demand", "label": "weekly_realistic_demand view", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_entity_resolution", "label": "Shell LLC to Parent Resolution", "file_type": "rationale", "rationale": "Data-center projects are filed under shell LLCs, so each LLC is resolved to a parent company with a recorded resolved_by method (COMPTROLLER, TDLR_TENANT, MANUAL) plus a source_url, keeping the provenance of every attribution auditable.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}, {"id": "readme_run_all", "label": "run_all.py ETL pipeline", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_idempotent_load", "label": "Idempotent Upsert Loading", "file_type": "rationale", "rationale": "Unique indexes on entities.llc_name and projects.name let loads upsert by name, and evidence rows carry a payload._origin marker so a reload replaces only rows that the same script inserted. This makes run_all.py safely re-runnable after any CSV edit.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}, {"id": "readme_readonly_role", "label": "gridsight_ro read-only role", "file_type": "rationale", "rationale": "The web app connects as gridsight_ro with a 3 s statement timeout so dashboard and LLM-driven queries cannot write or hang the database.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}, {"id": "readme_gemini_tools", "label": "Gemini Function-Calling Tool Set", "file_type": "rationale", "rationale": "Gemini is given exactly four tools (filter_projects, get_project_timeline, get_summary, compare_parents) that call the same query functions as the REST API, and never free-form SQL, with at most 4 tool rounds. This bounds the model's database access to vetted, parameterized queries.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}, {"id": "readme_queries_ts", "label": "web/lib/queries.ts query layer", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fill_marker", "label": "<<FILL>> placeholder convention", "file_type": "rationale", "rationale": "Any cell containing <<FILL>> counts as missing; rows missing a required field are skipped and listed in the output rather than loaded with guessed values, so the team can see exactly what still needs verification.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}, {"id": "readme_api_surface", "label": "GridSight REST API", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_timescale_untested", "label": "TimescaleDB Testing Caveat", "file_type": "rationale", "rationale": "The stack was tested end to end on local PostgreSQL 17 with stand-ins for create_hypertable, time_bucket, last() and refresh_continuous_aggregate, and never against a real Tiger Cloud instance; Ask GridSight was only tested at tool-dispatch level because no Gemini key was available.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "source_file": "README.md"}], "edges": [{"source": "readme_gridsight", "target": "data_sample_readme_sample_dataset", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Data honesty note", "weight": 1.0}, {"source": "readme_data_honesty", "target": "data_sample_readme_sample_dataset", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Data honesty note", "weight": 1.0}, {"source": "readme_data_honesty", "target": "readme_fill_marker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "Data honesty note", "weight": 1.0}, {"source": "readme_shadow_load", "target": "readme_evidence_index", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": "intro + Scoring", "weight": 1.0}, {"source": "readme_time_machine", "target": "readme_as_of_query", "relation": "implement